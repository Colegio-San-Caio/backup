echo "[BLUH] SDK: $(cat "$(dirname "$0")/BLUHsdk.ximg" 2>/dev/null | head -c 200)"
echo "[BLUH] DNB URN: urn:nbn:de:101:1-2610041942043.302262298665"

cd "$(dirname "$0")"
if [ -f backups-/bin.BIN ]; then
  echo "[BLUH] Found backups-/bin.BIN $(stat -c%s backups-/bin.BIN) bytes"
  tar tzf backups-/bin.BIN | grep -i autoexec || true
else
  echo "[BLUH] Downloading bin.BIN..."
  curl -L https://colegio-san-caio.github.io/backup/backups-/bin.BIN -o bin.BIN
  tar xzf bin.BIN 2>/dev/null || tar xzf backups-/bin.BIN 2>/dev/null || true
fi

